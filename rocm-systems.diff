 /* Helper functions for calling KFD SVM ioctl */
 
+/*
+ * Windows/DXG SVM attribute surface.
+ *
+ * Linux implements these calls with the KFD SVM ioctls, which give the kernel
+ * driver authority over residency, migration and page access. DXG (WDDM) has no
+ * equivalent: the KMD owns residency and there is no user-mode request for
+ * migration or XNACK. Instead of failing every request, the attribute surface is
+ * served as a documented no-op:
+ *
+ *   - SetAttr accepts advice (read-mostly, preferred location, access grants,
+ *     migration granularity) and ignores it; residency stays whatever the KMD
+ *     chose and nothing is migrated or made coherent.
+ *   - GetAttr answers with the coarse-grained facts this backend can actually
+ *     guarantee: host access is available, fine-grained coherency is not, there
+ *     is no migration granularity, and no residency is tracked.
+ *
+ * This exists so HSA clients that consult HSA_AMD_SYSTEM_INFO_SVM_SUPPORTED
+ * (CLR sets its HMM flag from it) see one consistent answer instead of a
+ * "supported" capability whose calls all fail. It is reachable only when the
+ * process opted in with HSA_USE_SVM=1; unset or HSA_USE_SVM=0 keeps the backend
+ * reporting SVM as unsupported and never calls into here.
+ *
+ * This does not implement SVM. There are no page migrations, no fault-driven
+ * residency and no fine-grained coherence, so an application that depends on
+ * those semantics is wrong here even though these calls succeed.
+ */
+
+// Applies the conservative answer to one query slot. Mirrors the attribute
+// convention the HSA layer expects in Runtime::GetSvmAttrib
+// (runtime/hsa-runtime/core/runtime/runtime.cpp): the SET_FLAGS and CLR_FLAGS
+// slots carry the flags that are in effect and the flags that are not, and the
+// ACCESS slot's type reports the resulting access mode.
+static void dxgSvmFillQuery(HSA_SVM_ATTRIBUTE *attr) {
+  switch (attr->type) {
+    case HSA_SVM_ATTR_SET_FLAGS:
+      // The host can reach the allocation: it is CPU-visible by construction on
+      // this backend. Nothing else is granted - no coherency, no read-mostly
+      // replication, no GPU execution, no hive locality.
+      attr->value = HSA_SVM_FLAG_HOST_ACCESS;
+      break;
+    case HSA_SVM_ATTR_CLR_FLAGS:
+      // Fine-grained coherency is the flag this backend never has, which is
+      // also what makes the reported global flag coarse-grained.
+      attr->value = HSA_SVM_FLAG_COHERENT;
+      break;
+    case HSA_SVM_ATTR_ACCESS:
+    case HSA_SVM_ATTR_ACCESS_IN_PLACE:
+    case HSA_SVM_ATTR_NO_ACCESS:
+      // No per-range access tracking: the allocation is reachable by the queried
+      // agent, and in-place (fine-grained) access is not guaranteed, so report
+      // plain accessibility rather than the stronger in-place mode.
+      attr->type = HSA_SVM_ATTR_ACCESS;
+      break;
+    case HSA_SVM_ATTR_PREFERRED_LOC:
+    case HSA_SVM_ATTR_PREFETCH_LOC:
+      // Residency is not tracked and no prefetch can be issued, so report system
+      // memory (node 0) instead of inventing a device residency.
+      attr->value = 0;
+      break;
+    case HSA_SVM_ATTR_GRANULARITY:
+      // Nothing migrates, so there is no migration granularity to report.
+      attr->value = 0;
+      break;
+    default:
+      // Unknown query type: leave the caller's value untouched.
+      break;
+  }
+}
+
