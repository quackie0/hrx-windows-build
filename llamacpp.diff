diff --git a/ggml/src/ggml-hrx/CMakeLists.txt b/ggml/src/ggml-hrx/CMakeLists.txt
index b3eb70120..684d396df 100644
--- a/ggml/src/ggml-hrx/CMakeLists.txt
+++ b/ggml/src/ggml-hrx/CMakeLists.txt
@@ -300,6 +300,20 @@ target_link_libraries(ggml-hrx PRIVATE ggml-hrx-kernel-corpus hrx::hrx loomc::lo
 target_include_directories(ggml-hrx PRIVATE . "${CMAKE_CURRENT_BINARY_DIR}" ../../../vendor)
 target_compile_definitions(ggml-hrx PRIVATE GGML_USE_HRX)
 
+# Sources the offline analysis tool (ggml-hrx-analyze-graph) needs. Derived from
+# the backend's own source list so the two cannot drift: everything under
+# graph/, dispatch/ and dispatch_registration/ is pure graph/dispatch logic with
+# no device or runtime dependency, whereas ggml-hrx.cpp, loom-jit.cpp and
+# runtime/ are the parts that actually touch hrx/loomc devices and the backend
+# registration entry points.
+get_target_property(GGML_HRX_BACKEND_SOURCES ggml-hrx SOURCES)
+set(GGML_HRX_ANALYSIS_SOURCES "")
+foreach(_source IN LISTS GGML_HRX_BACKEND_SOURCES)
+    if(_source MATCHES "^graph/" OR _source MATCHES "^dispatch/" OR _source MATCHES "^dispatch_registration/")
+        list(APPEND GGML_HRX_ANALYSIS_SOURCES "${_source}")
+    endif()
+endforeach()
+
 if (GGML_HRX_BUNDLE_RUNTIME_LIBS)
     include("${CMAKE_CURRENT_SOURCE_DIR}/cmake/BundleRuntime.cmake")
     ggml_hrx_bundle_runtime(ggml-hrx)
@@ -314,9 +328,24 @@ target_link_libraries(ggml-hrx-compile-kernel PRIVATE hrx::hrx loomc::loomc)
 target_include_directories(ggml-hrx-compile-kernel PRIVATE .)
 target_compile_features(ggml-hrx-compile-kernel PRIVATE cxx_std_17)
 
+# This tool is an in-tree developer utility, not a plugin consumer: it links the
+# backend's internal ggml::hrx:: graph/dispatch/command APIs directly. Those are
+# deliberately not part of the ggml-hrx export surface (only the GGML_BACKEND_API
+# entry points are), so on Windows they cannot be reached through the import
+# library and the link fails with "undefined symbol: ggml::hrx::...". ELF/Mach-O
+# import libraries still carry those definitions, which is why this only ever
+# failed on Windows. Compile the defining sources into the tool instead, matching
+# how ggml-hrx-compile-kernel above already avoids linking the backend DLL.
 add_executable(ggml-hrx-analyze-graph
     tools/analyze-graph.cpp
+    ${GGML_HRX_ANALYSIS_SOURCES}
+)
+target_link_libraries(ggml-hrx-analyze-graph PRIVATE ggml ggml-hrx-kernel-corpus hrx::hrx loomc::loomc)
+target_include_directories(ggml-hrx-analyze-graph PRIVATE
+    .
+    ../../../vendor
+    ${CMAKE_CURRENT_SOURCE_DIR}/..      # ggml-impl.h
+    ${CMAKE_CURRENT_BINARY_DIR}         # generated kernel corpus catalog headers
 )
-target_link_libraries(ggml-hrx-analyze-graph PRIVATE ggml-hrx ggml ggml-hrx-kernel-corpus)
-target_include_directories(ggml-hrx-analyze-graph PRIVATE . ../../../vendor)
+target_compile_definitions(ggml-hrx-analyze-graph PRIVATE GGML_USE_HRX)
 target_compile_features(ggml-hrx-analyze-graph PRIVATE cxx_std_17)
