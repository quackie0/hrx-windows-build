-    } else {
+    hrx_status_t status = hrx_gpu_initialize(0);
+    if (!hrx_status_is_ok(status)) {
+        const bool already_initialized = hrx_status_code(status) == HRX_STATUS_ALREADY_EXISTS;
         hrx_status_ignore(status);
-        return context;
+        if (!already_initialized) {
+            return context;
+        }
     }
     int count = 0;
     if (!HRX_CHECK(hrx_gpu_device_count(&count))) {
@@ -1177,8 +1159,13 @@ static std::unique_ptr<ggml_backend_hrx_reg_context> create_registry_context() {
 }  // namespace
 
 ggml_backend_reg_t ggml_backend_hrx_reg() {
-    static std::unique_ptr<ggml_backend_hrx_reg_context> context = create_registry_context();
-    static ggml_backend_reg registry = { GGML_BACKEND_API_VERSION, registry_i, context.get() };
+    // Intentionally leak the registry context. Its destructor calls
+    // hrx_gpu_shutdown(), which waits for runtime threads. On Windows the
+    // destructor runs from the DLL detach handler at process exit, after
+    // ExitProcess has terminated those threads, so the process hangs. WebGPU
+    // leaks its registry context for the same reason.
+    static ggml_backend_hrx_reg_context * context = create_registry_context().release();
+    static ggml_backend_reg registry = { GGML_BACKEND_API_VERSION, registry_i, context };
     for (auto & device : context->devices) {
